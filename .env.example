# Local developer preview only. Do not expose this server through a tunnel or reverse proxy.
HEXU_HOST=127.0.0.1
HEXU_PORT=4310
# HEXU_DATA_DIR=.hexu  # Optional override; defaults: preview=.hexu, team-local=.hexu/team

# Optional preview-only native file-tool execution. Disabled unless explicitly set to 1.
HEXU_NATIVE_ENABLED=0
# Enable only trusted Git worktree roots; use absolute paths, not HOME or filesystem root.
# HEXU_NATIVE_ROOTS=["/absolute/path/to/a/disposable-checkout"]
# HEXU_CLAUDE_BIN=/absolute/path/to/claude
# Supply ANTHROPIC_API_KEY via your local process environment (or untracked .env).
# Bare mode uses API billing, not an existing subscription login. Never commit a real key.

# Optional Codex App Server. Its API credential is separate from Claude.
# HEXU_CODEX_BIN=/absolute/path/to/codex
# Supply OPENAI_API_KEY only via local environment or untracked .env.
# Codex uses isolated temporary configuration, not subscription login or shared credentials.

# Optional real local accounts. Still loopback-only; no host execution or remote service.
HEXU_MODE=preview
# Set team-local to enable accounts. Keep HEXU_NATIVE_ENABLED=0 in that mode.
# First setup uses data-directory/setup-code; auth-secret is generated and retained locally.
# Do not commit database files, setup codes, auth secrets or passwords.
